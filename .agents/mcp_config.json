{
  "mcpServers": {
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.9.0",
        "serve"
      ],
      "description": "Reverse Engineer Anything (REA) MCP Server (Workspace Scope for REA-kit-agy)"
    },
    "rea-kit": {
      "command": "node",
      "args": [
        "dist/mcp.js",
        "--workspace",
        "${workspaceFolder}"
      ],
      "description": "REA-kit-agy Hybrid MCP Server v2.0"
    }
  }
}
