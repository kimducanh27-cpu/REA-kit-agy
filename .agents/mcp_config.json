{
  "mcpServers": {
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.9.0",
        "serve"
      ],
      "env": {
        "REA_MCP_INPUT_SCHEMA_PROFILE": "full"
      }
    },
    "rea-kit": {
      "command": "node",
      "args": [
        "${workspaceFolder}/dist/mcp.js",
        "--workspace",
        "${workspaceFolder}"
      ],
      "cwd": "${workspaceFolder}"
    }
  }
}
