{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "REA Context Receipt Schema",
  "description": "Authoritative schema for verification receipts and context compaction records in REA-kit-agy",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "packet_id",
    "stage",
    "verified_at",
    "verdict",
    "metrics",
    "compliance"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^RCPT-[0-9]{8}-[0-9]{6}-[a-f0-9]+$"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^PACK-[0-9]{8}-[0-9]{6}-[a-f0-9]+$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "STAGE_00_BOOTSTRAP",
        "STAGE_01_DISCOVERY",
        "STAGE_02_REVERSE_ENGINEERING",
        "STAGE_03_PRODUCT_DEFINITION",
        "STAGE_04_IMPLEMENTATION",
        "STAGE_05_VALIDATION"
      ]
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "metrics": {
      "type": "object",
      "required": [
        "total_documents",
        "total_characters",
        "total_tokens",
        "budget_limit",
        "budget_utilization_pct",
        "layer_tokens"
      ],
      "properties": {
        "total_documents": { "type": "integer", "minimum": 0 },
        "total_characters": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "budget_limit": { "type": "integer", "minimum": 0 },
        "budget_utilization_pct": { "type": "number", "minimum": 0, "maximum": 500 },
        "layer_tokens": {
          "type": "object",
          "properties": {
            "L0": { "type": "integer", "minimum": 0 },
            "L1": { "type": "integer", "minimum": 0 },
            "L2": { "type": "integer", "minimum": 0 },
            "L3": { "type": "integer", "minimum": 0 },
            "L4": { "type": "integer", "minimum": 0 },
            "L5": { "type": "integer", "minimum": 0 }
          },
          "required": ["L0", "L1", "L2", "L3", "L4", "L5"]
        }
      }
    },
    "compliance": {
      "type": "object",
      "required": [
        "stable_prefix_first",
        "dynamic_suffix_last",
        "untrusted_data_sandboxed",
        "budget_within_limit",
        "no_raw_binary_bloat"
      ],
      "properties": {
        "stable_prefix_first": { "type": "boolean" },
        "dynamic_suffix_last": { "type": "boolean" },
        "untrusted_data_sandboxed": { "type": "boolean" },
        "budget_within_limit": { "type": "boolean" },
        "no_raw_binary_bloat": { "type": "boolean" }
      }
    },
    "compaction_applied": {
      "type": "boolean"
    },
    "evicted_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
