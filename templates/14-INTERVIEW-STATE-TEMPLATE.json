{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InterviewState",
  "description": "Canonical schema for .agents/state/interview_state.json tracking adaptive interview sessions, goals, Q&A, decisions, assumptions, conflicts, and sufficiency evaluations.",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "session",
    "goals",
    "questions",
    "answers",
    "decisions",
    "assumptions",
    "conflicts",
    "unknowns",
    "scope_changes",
    "sufficiency_evaluation",
    "last_updated"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "default": 1
    },
    "case_id": {
      "type": "string"
    },
    "session": {
      "type": "object",
      "required": ["session_id", "status", "created_at", "updated_at"],
      "properties": {
        "session_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["NOT_STARTED", "IN_PROGRESS", "SUFFICIENT", "BLOCKED", "COMPLETED"]
        },
        "current_goal": { "type": ["string", "null"] },
        "current_stage": { "type": "string", "default": "STAGE_03_PRODUCT_DEFINITION" },
        "active_domain": { "type": ["string", "null"] },
        "design_mode": {
          "type": ["string", "null"],
          "enum": [
            "DESIGN_REUSE_EXACT",
            "DESIGN_STYLE_SPECIFIED",
            "DESIGN_STRUCTURAL_EXPLORATION",
            null
          ]
        },
        "max_clarification_per_goal": { "type": "integer", "default": 2 },
        "max_total_questions": { "type": "integer", "default": 15 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["goal_id", "description", "priority", "status"],
        "properties": {
          "goal_id": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0_CRITICAL", "P1_HIGH", "P2_MEDIUM", "P3_LOW"] },
          "status": {
            "type": "string",
            "enum": ["PROPOSED", "ACTIVE", "NEEDS_INPUT", "RESOLVED", "APPROVED", "DEFERRED", "ASSUMED_WITH_APPROVAL", "BLOCKED", "ACHIEVED", "ABANDONED"]
          },
          "related_requirements": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "question_text", "question_reason", "priority", "status"],
        "properties": {
          "question_id": { "type": "string" },
          "question_text": { "type": "string" },
          "question_reason": { "type": "string" },
          "domain": { "type": "string" },
          "related_goal_ids": { "type": "array", "items": { "type": "string" } },
          "related_decision_ids": { "type": "array", "items": { "type": "string" } },
          "expected_information": { "type": "string" },
          "topic_key": { "type": ["string", "null"] },
          "answer_format": {
            "type": "string",
            "enum": ["FREE_TEXT", "SINGLE_CHOICE", "MULTIPLE_CHOICE", "CONFIRMATION"]
          },
          "priority": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "status": { "type": "string", "enum": ["DRAFT", "ASKED", "ANSWERED", "SKIPPED", "DEFERRED", "NEEDS_CLARIFICATION"] },
          "asked_at": { "type": ["string", "null"] }
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["answer_id", "question_id", "original_answer", "interpreted_answer", "answer_type", "confidence", "recorded_at"],
        "properties": {
          "answer_id": { "type": "string" },
          "question_id": { "type": "string" },
          "original_answer": { "type": "string" },
          "interpreted_answer": { "type": "string" },
          "answer_type": {
            "type": "string",
            "enum": [
              "CLEAR",
              "PARTIAL",
              "AMBIGUOUS",
              "UNKNOWN",
              "CONDITIONAL",
              "MULTIPLE_CHOICE",
              "CONFLICTING",
              "OUT_OF_SCOPE",
              "NEW_REQUIREMENT",
              "SCOPE_CHANGE",
              "SPONTANEOUS_INFO",
              "DELEGATED_CHOICE"
            ]
          },
          "conflict_id": { "type": ["string", "null"] },
          "answer_source": { "type": "string", "enum": ["USER_EXPLICIT", "REPO_EVIDENCE", "DERIVED", "USER_SPONTANEOUS"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "recorded_at": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "description", "selected_option", "decision_owner", "approval_status"],
        "properties": {
          "decision_id": { "type": "string" },
          "description": { "type": "string" },
          "available_options": { "type": "array", "items": { "type": "string" } },
          "selected_option": { "type": "string" },
          "decision_owner": { "type": "string", "enum": ["USER_PO", "AGENT_ARCHITECT"] },
          "approval_status": {
            "type": "string",
            "enum": ["PROPOSED", "APPROVED", "REJECTED", "DEFERRED"]
          },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "related_requirements": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_id", "description", "rationale", "risk_level", "approval_status", "status"],
        "properties": {
          "assumption_id": { "type": "string" },
          "description": { "type": "string" },
          "rationale": { "type": "string" },
          "impact": { "type": "string" },
          "risk_level": { "type": "string", "enum": ["BENIGN", "CRITICAL"] },
          "approval_status": { "type": "string", "enum": ["PENDING_APPROVAL", "APPROVED", "REJECTED"] },
          "verification_task": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "INVALIDATED", "SUPERSEDED"] },
          "invalidated_at": { "type": ["string", "null"] },
          "revocation_reason": { "type": ["string", "null"] },
          "downstream_dependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "conflicting_items", "explanation", "severity", "resolution_status"],
        "properties": {
          "conflict_id": { "type": "string" },
          "conflicting_items": { "type": "array", "items": { "type": "string" } },
          "explanation": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "MAJOR", "MINOR"] },
          "resolution_status": { "type": "string", "enum": ["UNRESOLVED", "INVESTIGATING", "RESOLVED", "DEFERRED"] },
          "resolution_strategy": { "type": ["string", "null"] },
          "resolved_at": { "type": ["string", "null"] }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unknown_id", "description", "impact", "priority", "resolution_strategy"],
        "properties": {
          "unknown_id": { "type": "string" },
          "description": { "type": "string" },
          "impact": { "type": "string" },
          "priority": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "BENIGN"] },
          "status": { "type": "string", "enum": ["OPEN", "RESOLVED", "DEFERRED"], "default": "OPEN" },
          "resolution_strategy": { "type": "string" },
          "justification": { "type": ["string", "null"] },
          "approval": { "type": ["string", "null"] },
          "approval_status": { "type": ["string", "null"] }
        }
      }
    },
    "scope_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_id", "previous_scope", "new_scope", "recorded_at"],
        "properties": {
          "change_id": { "type": "string" },
          "previous_scope": { "type": "string" },
          "new_scope": { "type": "string" },
          "affected_decisions": { "type": "array", "items": { "type": "string" } },
          "affected_requirements": { "type": "array", "items": { "type": "string" } },
          "recorded_at": { "type": "string" }
        }
      }
    },
    "sufficiency_evaluation": {
      "type": "object",
      "required": ["verdict", "evaluated_at", "blocking_reasons", "deferred_decisions", "summary"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["PENDING", "SUFFICIENT", "BLOCKED", "NEEDS_INPUT"]
        },
        "evaluated_at": { "type": ["string", "null"] },
        "goal_evaluations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "deferred_decisions": { "type": "array", "items": { "type": "string" } },
        "assumptions_summary": { "type": "object" },
        "summary": { "type": "string" }
      }
    },
    "last_updated": {
      "type": "string"
    }
  }
}
