{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CaseManifest",
  "description": "Canonical schema for .agents/state/active_case.json tracking end-to-end case artifacts and 6-gate state transitions",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "target_name",
    "target_class",
    "current_phase",
    "current_step",
    "current_gate_status",
    "revision",
    "backup_verified",
    "gates",
    "artifacts",
    "metrics",
    "workflow",
    "last_updated"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "default": 2
    },
    "case_id": {
      "type": "string",
      "example": "APP-001"
    },
    "workflow": {
      "type": "object",
      "required": ["mode", "run_id"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "NEW_CASE",
            "RESUME_CASE",
            "CHANGE_REQUEST",
            "BUGFIX",
            "ANALYSIS_ONLY",
            "PLAN_ONLY",
            "WORKFLOW_REJOIN"
          ]
        },
        "parent_case_id": { "type": ["string", "null"] },
        "change_request_id": { "type": ["string", "null"] },
        "run_id": { "type": "string" },
        "target_fingerprint": { "type": ["string", "null"] },
        "execution_plan": { "type": "object" },
        "step_records": { "type": "object" },
        "skip_records": { "type": "array" },
        "invalidation_history": { "type": "array" },
        "reused_artifacts": { "type": "array" }
      }
    },
    "target_name": {
      "type": [
        "string",
        "null"
      ],
      "example": "sample-calculator.apk"
    },
    "target_class": {
      "type": "string",
      "enum": [
        "ANDROID_APK",
        "WEB_SPA",
        "ELECTRON_DESKTOP",
        "NATIVE_BINARY",
        "SOURCE_REPO",
        "CAPTURE"
      ]
    },
    "development_strategy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "STRATEGY_1_EXTEND",
        "STRATEGY_2_FEATURE_BRANCH",
        "STRATEGY_3_COMPATIBLE_CLEANROOM",
        "STRATEGY_4_FULL_REWRITE",
        null
      ]
    },
    "delivery_platform": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ROUTE_A_WEB_ZERO_INSTALL",
        "ROUTE_B_ANDROID_NATIVE",
        "ROUTE_C_PATCH_HYBRID",
        "ROUTE_D_DESKTOP_ELECTRON",
        null
      ]
    },
    "build_strategy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "STRATEGY_1_EXTEND",
        "STRATEGY_2_FEATURE_BRANCH",
        "STRATEGY_3_COMPATIBLE_CLEANROOM",
        "STRATEGY_4_FULL_REWRITE",
        null
      ]
    },
    "build_route": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ROUTE_A_WEB_ZERO_INSTALL",
        "ROUTE_B_ANDROID_NATIVE",
        "ROUTE_C_PATCH_HYBRID",
        "ROUTE_D_DESKTOP_ELECTRON",
        null
      ]
    },
    "current_phase": {
      "type": "string",
      "enum": [
        "STAGE_00_BOOTSTRAP",
        "STAGE_01_DISCOVERY",
        "STAGE_02_REVERSE_ENGINEERING",
        "STAGE_03_PRODUCT_DEFINITION",
        "STAGE_04_IMPLEMENTATION",
        "STAGE_05_VALIDATION"
      ]
    },
    "current_step": {
      "type": "string",
      "enum": [
        "00_PROJECT_BOOTSTRAP",
        "01_APP_INTAKE",
        "02_REFERENCE_BASELINE",
        "03_REA_SCAN",
        "04_REA_INVESTIGATE",
        "05_REA_AUDIT",
        "06_REA_INTERVIEW",
        "07_SPEC_AND_DESIGN",
        "08_IMPLEMENTATION_PLAN",
        "09_REA_BUILD",
        "10_BUILD_QA",
        "11_SMOKE_TEST",
        "12_HARD_VERIFY",
        "13_RELEASE_AND_HANDOFF"
      ]
    },
    "current_gate_status": {
      "type": "string",
      "example": "GATE_00_READY"
    },
    "next_prompt_guide": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "backup_verified": {
      "type": "boolean",
      "default": false
    },
    "gates": {
      "type": "object",
      "required": [
        "gate_01_baseline_verified",
        "gate_02_audit_passed",
        "gate_03_spec_frozen",
        "gate_04_build_qa_passed",
        "gate_05_hard_verify_passed",
        "gate_06_handoff_signed"
      ],
      "patternProperties": {
        "^gate_0[1-6]": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "NOT_STARTED",
                "IN_PROGRESS",
                "PASS",
                "PASS_WITH_LIMITATIONS",
                "SKIPPED",
                "NOT_APPLICABLE",
                "WAIVED",
                "BLOCKED",
                "FAILED",
                "INVALIDATED",
                "REUSED_VALIDATED",
                "NOT_RUN",
                "REVOKED"
              ]
            },
            "baseline_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "approved_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "approved_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "revoked_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "waived_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "skip_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "backup_file": {
          "type": [
            "string",
            "null"
          ],
          "example": "04_SAO_LUU_AN_TOAN/sample-calculator.apk"
        },
        "baseline_evidence": {
          "type": [
            "string",
            "null"
          ],
          "example": "01_THA_APP_VAO_DAY/baseline/"
        },
        "interview_state": {
          "type": [
            "string",
            "null"
          ],
          "example": ".agents/state/interview_state.json"
        },
        "scan_report": {
          "type": [
            "string",
            "null"
          ],
          "example": "03_KET_QUA_KIEM_TRA/bao-cao-hien-trang.md"
        },
        "unknowns_and_coverage": {
          "type": [
            "string",
            "null"
          ],
          "example": "03_KET_QUA_KIEM_TRA/UNKNOWNS_AND_COVERAGE.md"
        },
        "design_contract": {
          "type": [
            "string",
            "null"
          ],
          "example": "02_YEU_CAU_CUA_TOI/design.md"
        },
        "frozen_spec": {
          "type": [
            "string",
            "null"
          ],
          "example": "03_KET_QUA_KIEM_TRA/dac-ta-yeu-cau-da-chot.md"
        },
        "implementation_plan": {
          "type": [
            "string",
            "null"
          ],
          "example": "03_KET_QUA_KIEM_TRA/KE_HOACH_TRIEN_KHAI.md"
        },
        "build_qa_report": {
          "type": [
            "string",
            "null"
          ],
          "example": "03_KET_QUA_KIEM_TRA/KET_QUA_KIEM_THU.md"
        },
        "hard_verify_report": {
          "type": [
            "string",
            "null"
          ],
          "example": "03_KET_QUA_KIEM_TRA/BAO_CAO_NGHIEM_THU_HARD_VERIFY.md"
        },
        "handoff_bundle": {
          "type": [
            "string",
            "null"
          ],
          "example": "05_MA_NGUON_PHAT_TRIEN/BAN_GIAO_SAN_PHAM.md"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "coverage_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "unknowns_count": {
          "type": "integer",
          "minimum": 0
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "UNASSESSED",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "review_convergence_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "max_convergence_rounds": {
          "type": "integer",
          "default": 2
        }
      }
    },
    "interview": {
      "type": "object",
      "properties": {
        "state_file": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["NOT_STARTED", "IN_PROGRESS", "SUFFICIENT", "BLOCKED", "COMPLETED"]
        },
        "session_id": { "type": ["string", "null"] },
        "active_goals_count": { "type": "integer", "minimum": 0 },
        "decisions_count": { "type": "integer", "minimum": 0 },
        "unresolved_conflicts_count": { "type": "integer", "minimum": 0 },
        "critical_assumptions_count": { "type": "integer", "minimum": 0 },
        "sufficiency_verdict": {
          "type": ["string", "null"],
          "enum": ["PENDING", "SUFFICIENT", "BLOCKED", "NEEDS_INPUT", null]
        }
      }
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  }
}
