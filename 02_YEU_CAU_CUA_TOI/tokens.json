{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "REA W3C DTCG Design Tokens",
  "version": "1.0.0",
  "global": {
    "color": {
      "blue-600": { "$value": "#2563eb", "$type": "color", "$description": "Màu xanh thương hiệu chính" },
      "blue-700": { "$value": "#1d4ed8", "$type": "color", "$description": "Màu xanh khi hover" },
      "slate-50": { "$value": "#f8fafc", "$type": "color", "$description": "Nền xám nhạt toàn ứng dụng" },
      "white": { "$value": "#ffffff", "$type": "color", "$description": "Bề mặt thẻ trắng" },
      "slate-200": { "$value": "#e2e8f0", "$type": "color", "$description": "Đường viền ngăn cách" },
      "slate-900": { "$value": "#0f172a", "$type": "color", "$description": "Màu chữ tiêu đề chính" },
      "slate-500": { "$value": "#64748b", "$type": "color", "$description": "Màu chữ phụ mờ" },
      "emerald-500": { "$value": "#10b981", "$type": "color", "$description": "Màu xanh lá thành công" },
      "red-500": { "$value": "#ef4444", "$type": "color", "$description": "Màu đỏ cảnh báo/lỗi" },
      "amber-500": { "$value": "#f59e0b", "$type": "color", "$description": "Màu vàng cảnh báo" },
      "sky-600": { "$value": "#0284c7", "$type": "color", "$description": "Màu xanh dương chỉ dẫn" }
    },
    "dimension": {
      "radius-sm": { "$value": "6px", "$type": "dimension", "$description": "Bo góc nhỏ cho nút bấm, ô input" },
      "radius-md": { "$value": "12px", "$type": "dimension", "$description": "Bo góc vừa cho thẻ card" },
      "radius-lg": { "$value": "20px", "$type": "dimension", "$description": "Bo góc lớn cho modal, dialog" },
      "target-min": { "$value": "48px", "$type": "dimension", "$description": "Vùng chạm cảm ứng tối thiểu WCAG AA" }
    },
    "font": {
      "family-main": { "$value": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif", "$type": "fontFamily" },
      "size-sm": { "$value": "14px", "$type": "dimension" },
      "size-base": { "$value": "16px", "$type": "dimension" },
      "size-lg": { "$value": "20px", "$type": "dimension" },
      "size-xl": { "$value": "24px", "$type": "dimension" },
      "line-height-base": { "$value": 1.5, "$type": "number" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration", "$description": "Chuyển động vi mô nút/checkbox" },
      "base": { "$value": "250ms", "$type": "duration", "$description": "Chuyển đổi thành phần dropdown/card" },
      "slow": { "$value": "400ms", "$type": "duration", "$description": "Chuyển trang hoặc cấu trúc lớn" }
    }
  },
  "semantic": {
    "color": {
      "primary": { "$value": "{global.color.blue-600}", "$type": "color" },
      "primary-hover": { "$value": "{global.color.blue-700}", "$type": "color" },
      "background": { "$value": "{global.color.slate-50}", "$type": "color" },
      "surface": { "$value": "{global.color.white}", "$type": "color" },
      "border": { "$value": "{global.color.slate-200}", "$type": "color" },
      "text-main": { "$value": "{global.color.slate-900}", "$type": "color" },
      "text-muted": { "$value": "{global.color.slate-500}", "$type": "color" },
      "accent": { "$value": "{global.color.emerald-500}", "$type": "color" },
      "danger": { "$value": "{global.color.red-500}", "$type": "color" },
      "warning": { "$value": "{global.color.amber-500}", "$type": "color" },
      "info": { "$value": "{global.color.sky-600}", "$type": "color" }
    },
    "dimension": {
      "radius-button": { "$value": "{global.dimension.radius-sm}", "$type": "dimension" },
      "radius-card": { "$value": "{global.dimension.radius-md}", "$type": "dimension" },
      "radius-modal": { "$value": "{global.dimension.radius-lg}", "$type": "dimension" },
      "touch-target": { "$value": "{global.dimension.target-min}", "$type": "dimension" }
    },
    "duration": {
      "motion-fast": { "$value": "{global.duration.fast}", "$type": "duration" },
      "motion-base": { "$value": "{global.duration.base}", "$type": "duration" },
      "motion-slow": { "$value": "{global.duration.slow}", "$type": "duration" }
    }
  },
  "component": {
    "button": {
      "primary": {
        "background": { "$value": "{semantic.color.primary}", "$type": "color" },
        "color": { "$value": "{global.color.white}", "$type": "color" },
        "radius": { "$value": "{semantic.dimension.radius-button}", "$type": "dimension" },
        "min-height": { "$value": "{semantic.dimension.touch-target}", "$type": "dimension" }
      }
    },
    "card": {
      "background": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "{semantic.dimension.radius-card}", "$type": "dimension" }
    },
    "input": {
      "background": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "{semantic.dimension.radius-button}", "$type": "dimension" },
      "min-height": { "$value": "{semantic.dimension.touch-target}", "$type": "dimension" }
    }
  }
}
